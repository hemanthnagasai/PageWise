# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here


# CHAT_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=models/gemini-embedding-001

# When to run the vision model during ingestion.
#   auto  only on pages that look like they contain a table, chart or image
#   all   every page
#   off   never
# VISION_MODE=auto

# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVER_K=5
# PAGE_RENDER_DPI=150
