# Which provider answers questions and reads page images: google, openai or anthropic
LLM_PROVIDER=google

# Only the key for the provider you picked is needed. Embeddings use the same
# provider, except with anthropic, which falls back to a local model (no key).
# Google:    https://aistudio.google.com/apikey
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
GOOGLE_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# Embeddings can come from a different provider than chat: google, openai or local.
# EMBEDDING_PROVIDER=local

# Defaults per provider:
#   google     gemini-3.5-flash            models/gemini-embedding-001
#   openai     gpt-5.4-mini                text-embedding-3-small
#   anthropic  claude-haiku-4-5-20251001   local (EMBEDDING_MODEL is ignored)
# CHAT_MODEL=
# EMBEDDING_MODEL=

# When to run the vision model during ingestion.
#   auto  only on pages that look like they contain a table, chart or image
#   all   every page
#   off   never
# VISION_MODE=auto

# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVER_K=5
# PAGE_RENDER_DPI=150
